# Copier ce fichier en .env et remplir les valeurs (le fichier .env n'est jamais envoyé sur Git).

# Navigateur (clé publique « publishable » du projet Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Facultatif : bouton « Voir la démo » (compte en lecture seule ; ces valeurs deviennent visibles dans le navigateur)
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Côté serveur uniquement (secrets de l'Edge Function sync-notion, jamais dans le navigateur)
NOTION_TOKEN=
SUPABASE_SECRET_KEY=
